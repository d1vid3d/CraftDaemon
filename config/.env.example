# Copy this file to ".env", then fill in your values.
# Keep .env private (never commit it). It contains credentials.
#
# Notes:
# - Values are shown with defaults where applicable.
# - If a value is missing, the bot uses the default in code.
# - Ranges below are practical guidance for stable behavior.

# ============================================================
# Logging
# ============================================================
LOG_LEVEL="INFO"                      # Default: INFO | Options: DEBUG, INFO, WARN, ERROR
DEBUG_PERMS="false"                   
# If "true", logs  (user, command, allowed) for permission checks

# ============================================================
# Required Discord config
# ============================================================
TOKEN="YOUR_BOT_TOKEN_HERE"           # Required. Discord Developer Portal.
GUILD_ID="YOUR_SERVER_ID_HERE"        # Required for command registration script.
CLIENT_ID="YOUR_CLIENT_ID_HERE"       # Required for command registration script.

# ============================================================
# Required Minecraft/systemd config
# ============================================================
MC_SERVICE="minecraft"                # Default: "minecraft". Your systemd service unit name.
STATUS_CHANNEL_ID="YOUR_CHANNEL_ID"   # Required for auto-stop warning/shutdown messages.

# ============================================================
# RCON connection config (required except host/port)
# ============================================================
RCON_HOST="127.0.0.1"                 # Default: 127.0.0.1
RCON_PORT="25575"                     # Default: 25575 | Valid: 1-65535
RCON_PASSWORD="YOUR_RCON_PASSWORD"    # Required. Must match server.properties

# ============================================================
# Auto-stop behavior
# ============================================================
AUTO_STOP_MINUTES="10"                # Default: 10 | 0 disables auto-stop | Suggested: 5-60
WARNING_MINUTES="8"                   # Default: 8  | 0 disables warning | Should be below AUTO_STOP_MINUTES
CHECK_INTERVAL_MS="30000"             # Default: 30000 | Suggested: 10000-60000

# SAVEALL_DELAY_MS controls delay between "save-all" and stop/restart.
# Too low may risk incomplete flush on slower disks/worlds.
# Too high just makes stop/restart feel slower.
SAVEALL_DELAY_MS="1000"               # Default: 1000 | Suggested: 500-3000

# ============================================================
# Command Behavior
# ============================================================
# Minimum interval between accepting start/stop/restart commands to prevent spamming. Put 0 to disable cooldown (not recommended).
# Too low => risk of spamming commands and overwhelming systemd or the server.
# Too high => may feel unresponsive to users who legitimately need to issue commands in quick succession
COMMAND_COOLDOWN_MS="10000"          # Default: 10000 | Suggested: 2000-60000

# ============================================================
# Presence behavior
# ============================================================
# Used only when RCON is disconnected to determine Starting vs Offline from systemd.
PRESENCE_SYSTEMD_FALLBACK_INTERVAL_MS="15000"  # Default: 15000 | Suggested: 10000-30000

# ============================================================
# Persistent RCON manager tuning
# ============================================================
# Keepalive interval:
# - Too low => unnecessary command traffic/log noise.
# - Too high => slower stale-connection detection.
RCON_KEEPALIVE_INTERVAL_MS="45000"    # Default: 45000 | Suggested: 30000-60000

# Reconnect delay:
# - Too low => spam reconnect attempts during downtime.
# - Too high => slow recovery after server comes back.
RCON_RECONNECT_INTERVAL_MS="5000"     # Default: 5000 | Suggested: 3000-10000

# Starting grace period after reconnect:
# - While active, presence stays "Starting..." before switching to player count.
RCON_STARTING_GRACE_PERIOD_MS="10000" # Default: 10000 | Suggested: 5000-20000

# Command timeout for RCON calls:
# - Too low => false timeouts under load.
# - Too high => slower detection of real stalls.
RCON_COMMAND_TIMEOUT_MS="8000"        # Default: 8000 | Suggested: 5000-15000

# Consecutive keepalive failures needed before forcing reconnect:
# - 1 = aggressive (faster failover, more false disconnect risk)
# - 2-3 = better stability for busy servers
RCON_MAX_KEEPALIVE_FAILURES="2"       # Default: 2 | Suggested: 2-3

# Minimum interval between repeated ECONNREFUSED warning logs while retrying.
# Set to 0 to log only the first refusal, then stay quiet until recovery.
RCON_REFUSED_LOG_INTERVAL_MS="60000"  # Default: 60000 | 0 = first-only | Suggested: 0 or 30000-120000

# ============================================================
# Optional status/address display fields
# ============================================================
MAIN_ADDRESS="play.example.com:25565" # Optional. Used in /address and /status.
JAVA_EDITION_VERSION="1.21.x"         # Optional. Used in /address.
LOCAL_ADDRESS="192.168.1.10:25565"    # Optional. Used in /address.

# ============================================================
# Optional: GitHub release update announcements
# ============================================================
# If set, update embeds are sent to this channel when it exists inside a guild the bot is in,
# and the bot has View Channel + Send Messages + Embed Links there. Other guilds (or if the
# channel is missing or unusable) fall back to the system channel, then the first suitable text channel.
UPDATE_NOTIFY_CHANNEL_ID=""           # Optional. Discord channel ID (e.g. #bot-updates).
UPDATE_SERVICE_DEBUG="false"          # Optional. "true" enables UPDATE_SERVICE_FORCE_LATEST.
UPDATE_SERVICE_FORCE_LATEST=""        # Optional. Mock newer semver when debug is true (skips GitHub for version).