# Discord Information
TOKEN = "YOUR_BOT_TOKEN_HERE" # Get this from the Discord Developer Portal, also used for patchnotes-broadcast.js
GUILD_ID = "YOUR_SERVER_ID_HERE" # Get this by enabling Developer Mode in Discord Settings > Advanced, then right-clicking your server icon and selecting Copy ID
CLIENT_ID = "YOUR_CLIENT_ID_HERE" # Also from the Discord Developer Portal, under your application settings

# RCON Information
RCON_HOST="127.0.0.1" # Assuming the Minecraft server is running on the same machine as the bot, change accordingly if not
RCON_PORT="25575" # Default RCON port for Minecraft servers, change if your server uses a different port (RCON)
RCON_PASSWORD="YOUR_RCON_PASSWORD_HERE" # Set this to your RCON password, which is configured in your server.properties file (rcon.password=yourpassword)

# Auto-Stop Configuration (Optional, but recommended to prevent unnecessary resource usage and costs)
AUTO_STOP_MINUTES="10" # Number of minutes of inactivity (no players online) before the bot automatically stops the server, change as needed or set to 0 to disable auto-shutdown
WARNING_MINUTES="8" # Number of minutes of inactivity before the bot sends a warning message to the Discord channel, change as needed or set to 0 to disable warnings
CHECK_INTERVAL="30000" # How often (in milliseconds) the bot checks for player activity and whether to send warnings or stop the server, change as needed (e.g. 60000 for 1 minute intervals)

# Minecraft Server Information
MC_SERVICE="YOUR_MINECRAFT_SERVICE_NAME_HERE" # The name of your Minecraft server's systemd service, check documentation for details if you don't know

# Discord Channel IDs
STATUS_CHANNEL_ID="YOUR_STATUS_CHANNEL_ID_HERE" # Get this by right-clicking the channel in Discord and selecting Copy ID, also used for patchnotes-broadcast.js

# Connection Information (For /address command and status embeds, optional but recommended to set)
JAVA_EDITION_VERSION="JAVA_EDITION_VERSION_HERE" #Optional: but to tell players which version your server is running, set it here to have it show up in the bot's status embeds and `/status` command
MAIN_ADDRESS="YOUR_MAIN_ADDRESS_HERE" # For your main server address (e.g. from Playit.gg, tunnels, or port-forwarding), set it here to have it show up in the bot's `/address` command and status embeds
LOCAL_ADDRESS="YOUR_LOCAL_ADDRESS_HERE" # Optional: If your server is running on the same machine as the bot, you can set this to the local IP address and port (e.g.